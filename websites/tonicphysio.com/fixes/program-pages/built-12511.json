[{"id": "9618aa7", "elType": "container", "settings": {"min_height": {"unit": "px", "size": 400, "sizes": []}, "background_background": "classic", "background_image": {"url": "https://tonicphysio.com/wp-content/uploads/2025/01/Physiotherapy-service.jpg", "id": 6309, "size": "", "alt": "Physiotherapy in Milton", "source": "library"}, "background_repeat": "no-repeat", "background_size": "cover", "background_overlay_image": {"url": "", "id": "", "size": "", "alt": "Physiotherapy in Milton", "source": "library"}, "background_overlay_position": "center center", "background_overlay_repeat": "no-repeat", "background_overlay_size": "cover", "__dynamic__": {"background_image": "[elementor-tag id=\"60793ad\" name=\"post-featured-image\" settings=\"%7B%7D\"]"}}, "elements": [], "isInner": false}, {"id": "5947bedb", "elType": "container", "settings": {"flex_direction": "row", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0"}, "flex_wrap_tablet": "wrap", "boxed_width": {"unit": "px", "size": 1300, "sizes": []}, "background_color": "#FFFFFF", "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "padding": {"unit": "px", "top": "50", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "__globals__": {"background_color": "", "background_color_b": "globals/colors?id=8891650"}}, "elements": [{"id": "14185019", "elType": "container", "settings": {"flex_direction": "column", "content_width": "full", "width": {"unit": "%", "size": 100}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "service-details__content", "margin_tablet": {"unit": "px", "top": "0", "right": "020", "bottom": "0", "left": "20", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "15", "bottom": "0", "left": "15", "isLinked": false}}, "elements": [{"id": "b2a709c", "elType": "widget", "settings": {"shortcode": "[wpseo_breadcrumb]"}, "elements": [], "widgetType": "global", "templateID": "11123"}, {"id": "b26ef64", "elType": "widget", "settings": {"title": "Running Injury Assessment in Milton", "header_size": "h1", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "heading"}, {"id": "fb2de65", "elType": "widget", "settings": {"editor": "<div><p><span style=\"font-size: 16px;\">Running injuries are usually training-load problems wearing a local diagnosis: shin pain, knee pain, Achilles irritation, plantar fascia, IT band, or a calf that keeps going. A running injury assessment at Tonic Physio in Milton looks at the tissue and the way you load it.</span></p><p><span style=\"font-size: 16px;\">We combine a physiotherapy exam with a practical look at gait, cadence, strength, and how fast your mileage changed. The aim is to keep you running when it is safe, and to stop the cycle of rest-then-repeat.</span></p><p><span style=\"font-size: 16px;\">Whether you are training for a race or running to stay well, you do not need to guess between \u201cpush through\u201d and \u201cstop everything.\u201d</span></p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "d3ac145"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "37dba0e"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5bd4a37", "elType": "widget", "settings": {"skin": "cover", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "title": "Feel Better. Move Better. Live Fully.", "title_tag": "span", "description": "Trusted care that helps you move better and feel better. Call or book online now.", "description_tag": "span", "button": "Book Appointment Now", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "button_hover_background_color": "#8695D8", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "10", "left": "0", "isLinked": false}, "__globals__": {"button_hover_background_color": ""}, "ribbon_title": "Tonic Physio", "ribbon_horizontal_position": "right", "motion_fx_motion_fx_scrolling": "yes"}, "elements": [], "widgetType": "global", "templateID": "9260"}, {"id": "c285d5e", "elType": "widget", "settings": {"editor": "<div><h2>Injuries We Commonly See in Runners</h2><p>Patellofemoral pain, IT band irritation, Achilles tendinopathy, plantar fasciitis, shin splints, hamstring and calf strains, and hip-related pain all show up in this clinic. Many share the same drivers: too much too soon, weak hips or calves, and a gait that overloads one side.</p><ul><li>Knee pain that starts after a mileage jump</li><li>Achilles or plantar pain in the first morning steps</li><li>Shin pain that appears as speed or hills increase</li></ul><p>If the same injury keeps returning after you \u201crest it,\u201d the missing piece is usually capacity and mechanics, not another week off.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "1809915"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0fea156"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5b7f42b", "elType": "widget", "settings": {"editor": "<div><h2>Gait, Strength, and Load</h2><p>We look at step rate, overstriding, hip control, and calf capacity. Small changes in cadence or strength often matter more than a dramatic form overhaul.</p><ul><li>Strength testing for the chain that supports running</li><li>Guidance on shoes and when custom orthotics are worth considering</li><li>A return-to-run ladder you can follow between visits</li></ul><p>You may also need a broader <a href=\"https://tonicphysio.com/physiotherapy-in-milton/functional-movement-assessment/\">functional movement assessment</a> if squatting, landing, or single-leg control is clearly limited off the road.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "92c6f74"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "7cb9ba2"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "09ec148", "elType": "widget", "settings": {"image": {"url": "https://tonicphysio.com/wp-content/uploads/2026/05/Running-Injury-Assessment-leg-checking-tonic-physio.jpg", "id": 12762, "size": "", "alt": "Running injury assessment and gait review at Tonic Physio Milton", "source": "library"}, "image_size": "full", "align": "center", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "20", "left": "0", "isLinked": false}}, "elements": [], "widgetType": "image"}, {"id": "fdccfc6", "elType": "widget", "settings": {"editor": "<div><h2>What We Look at in Runners</h2><p>These are the practical pieces we build into your plan:</p><ul><li>History of mileage, surfaces, shoes, and previous injuries.</li><li>Strength of hips, calves, and foot control.</li><li>Cadence, overstride, and obvious gait inefficiencies.</li><li>Training-load errors that keep tissues irritated.</li><li>A plan to keep you running when it is safe, not always a full stop.</li><li>Footwear and orthotic discussion when structure is part of the picture.</li></ul></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "9f8a561", "elType": "widget", "settings": {"editor": "<div><h2>Why Runners Come to Tonic Physio</h2><p>You get a Milton clinic that treats running injuries weekly and will tell you whether to keep easy running, switch to cross-training, or stop impact for a short window.</p><p>We also connect this visit to <a href=\"https://tonicphysio.com/physiotherapy-in-milton/\">physiotherapy</a> and, when you are ready, a staged return to faster work.</p><p>Bring your current shoes and a short description of your last four weeks of training.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "aef1606"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "49a15fd"}]}, "elements": [], "widgetType": "text-editor"}], "isInner": true}, {"id": "2f8706ae", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 25}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "20", "isLinked": false}, "background_overlay_opacity": {"unit": "px", "size": 1, "sizes": []}, "border_border": "none", "border_radius": {"unit": "px", "top": "20", "right": "20", "bottom": "20", "left": "20", "isLinked": true}, "_flex_size": "none", "css_classes": "service-sidebar__info service-sidebar__single", "hide_tablet": "hidden-tablet", "hide_mobile": "hidden-mobile", "__globals__": {"background_overlay_color": "globals/colors?id=0712892"}}, "elements": [{"id": "29b04101", "elType": "widget", "settings": {"title": "ALL SERVICES", "nav_menus": [{"_id": "4b4c20a", "nav_menu": "services-menu"}]}, "elements": [], "widgetType": "sidebar-nav"}, {"id": "6f1ddb3", "elType": "widget", "settings": {"skin": "cover", "layout": "above", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "graphic_element": "icon", "selected_icon": {"value": "icon icon-contact-form", "library": "ekiticons"}, "title": "MONDAY TO SATURDAY", "title_tag": "span", "description": "905-878-7775", "description_tag": "span", "button": "Book Appointment", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "vertical_position": "middle", "title_typography_typography": "custom", "title_typography_font_family": "Plus Jakarta Sans", "title_typography_font_size": {"unit": "px", "size": 26, "sizes": []}, "title_typography_font_weight": "600", "title_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "description_typography_typography": "custom", "description_typography_font_family": "Plus Jakarta Sans", "description_typography_font_weight": "600", "description_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "button_text_color": "#FFFFFF", "button_background_color": "#8695D8", "_margin": {"unit": "px", "top": "30", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "__globals__": {"title_typography_typography": "globals/typography?id=secondary", "description_typography_typography": "globals/typography?id=accent", "button_background_color": "globals/colors?id=secondary", "button_text_color": "globals/colors?id=0712892", "button_border_color": ""}, "link_click": "box"}, "elements": [], "widgetType": "global", "templateID": "10400"}], "isInner": true}], "isInner": false}, {"id": "4249e5c", "elType": "container", "settings": {"padding": {"unit": "px", "top": "50", "right": "0", "bottom": "50", "left": "0", "isLinked": ""}, "ekit_all_conditions_list": [{"_id": "ca7a7c3"}], "ekit_section_parallax_multi_items": [], "ekit_cursor_text_label": "Elementskit Cursor", "flex_direction": "column", "flex_align_items": "stretch", "flex_gap": {"size": 10, "column": "10", "row": "10", "unit": "px", "isLinked": true}, "padding_tablet": {"unit": "px", "top": "70", "right": "10", "bottom": "70", "left": "10", "isLinked": false}, "__globals__": {"background_color": "globals/colors?id=8891650", "background_color_b": ""}, "background_color_b": "#FFFFFF", "background_color": "#F3E5F2", "background_color_b_stop": {"unit": "%", "size": 28, "sizes": []}}, "elements": [{"id": "782bdc1", "elType": "widget", "settings": {"title": "FAQs About Running Injury Assessment", "header_size": "h3", "title_color": "#000000", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "500", "typography_text_transform": "capitalize", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "e2e6de9"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "aa60a26"}]}, "elements": [], "widgetType": "heading"}, {"id": "0c0374b", "elType": "widget", "elements": [], "widgetType": "elementskit-accordion", "settings": {"ekit_accordion_items": [{"acc_title": "Should I stop running completely?", "acc_content": "<p>Not always. Many runners can keep a reduced, easy volume while we treat the tissue. We will be specific. Complete rest is used when running clearly keeps the injury irritable.</p>", "ekit_acc_is_active": "yes", "_id": "019449d"}, {"acc_title": "Do I need a video of my gait?", "acc_content": "<p>Helpful, not required. A phone video from the side and behind on a treadmill or path is enough for a first look.</p>", "ekit_acc_is_active": "", "_id": "9ccbe1f"}, {"acc_title": "Is this only for marathoners?", "acc_content": "<p>No. Beginners, return-to-running after time off, and recreational runners are the majority of visits.</p>", "ekit_acc_is_active": "", "_id": "bde59ea"}, {"acc_title": "Can you help with shoe choice?", "acc_content": "<p>We can discuss what your foot and gait suggest. We do not replace a proper running-store fitting, but we will flag shoes that are clearly working against you.</p>", "ekit_acc_is_active": "", "_id": "befc748"}, {"acc_title": "Will I get a training plan?", "acc_content": "<p>You get a return-to-run structure and load rules. We are not your running coach, but rehab only works if training load is part of the plan.</p>", "ekit_acc_is_active": "", "_id": "65d94c1"}, {"acc_title": "How soon can I race again?", "acc_content": "<p>That depends on the tissue, how long it has been irritated, and the race demand. We would rather you start the race prepared than start it early.</p>", "ekit_acc_is_active": "", "_id": "c7ad28c"}, {"acc_title": "Do you treat walk-to-run beginners?", "acc_content": "<p>Yes. Many \u201cinjuries\u201d in new runners are simply load progressing faster than tissue capacity.</p>", "ekit_acc_is_active": "", "_id": "2383368"}, {"acc_title": "How do I book?", "acc_content": "<p>Book a running injury assessment at Tonic Physio in Milton online or by phone. Wear shorts and bring your running shoes.</p>", "ekit_acc_is_active": "", "_id": "520056e"}], "ekit_accordian_faq_schema": "yes", "ekit_accordion_background_color": "#473872", "ekit_accordion_title_color_close": "#FFFFFF", "ekit_accordion_background_close_background": "classic", "ekit_accordion_background_close_color": "#473872", "__globals__": {"ekit_accordion_title_color_close": "globals/colors?id=0712892", "ekit_accordion_background_close_color": "globals/colors?id=accent", "ekit_accordion_content_background_color": "globals/colors?id=text", "ekit_accordion_content_color": "globals/colors?id=text", "ekit_accordion_content_typography_typography": "globals/typography?id=text"}, "ekit_accordion_content_border_radious": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}, "ekit_accordion_content_padding": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}}}], "isInner": false}, {"id": "60186c47", "elType": "container", "settings": {"flex_direction": "column", "content_width": "full", "min_heigh
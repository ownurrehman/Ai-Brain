[{"id": "9618aa7", "elType": "container", "settings": {"min_height": {"unit": "px", "size": 400, "sizes": []}, "background_background": "classic", "background_image": {"url": "https://tonicphysio.com/wp-content/uploads/2025/01/Physiotherapy-service.jpg", "id": 6309, "size": "", "alt": "Physiotherapy in Milton", "source": "library"}, "background_repeat": "no-repeat", "background_size": "cover", "background_overlay_image": {"url": "", "id": "", "size": "", "alt": "Physiotherapy in Milton", "source": "library"}, "background_overlay_position": "center center", "background_overlay_repeat": "no-repeat", "background_overlay_size": "cover", "__dynamic__": {"background_image": "[elementor-tag id=\"60793ad\" name=\"post-featured-image\" settings=\"%7B%7D\"]"}}, "elements": [], "isInner": false}, {"id": "5947bedb", "elType": "container", "settings": {"flex_direction": "row", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0"}, "flex_wrap_tablet": "wrap", "boxed_width": {"unit": "px", "size": 1300, "sizes": []}, "background_color": "#FFFFFF", "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "padding": {"unit": "px", "top": "50", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "__globals__": {"background_color": "", "background_color_b": "globals/colors?id=8891650"}}, "elements": [{"id": "14185019", "elType": "container", "settings": {"flex_direction": "column", "content_width": "full", "width": {"unit": "%", "size": 100}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "service-details__content", "margin_tablet": {"unit": "px", "top": "0", "right": "020", "bottom": "0", "left": "20", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "15", "bottom": "0", "left": "15", "isLinked": false}}, "elements": [{"id": "b2a709c", "elType": "widget", "settings": {"shortcode": "[wpseo_breadcrumb]"}, "elements": [], "widgetType": "global", "templateID": "11123"}, {"id": "b26ef64", "elType": "widget", "settings": {"title": "Functional Movement Assessment in Milton", "header_size": "h1", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "heading"}, {"id": "fb2de65", "elType": "widget", "settings": {"editor": "<div><p><span style=\"font-size: 16px;\">Understanding how your body moves is the foundation of injury prevention and better performance. A functional movement assessment at Tonic Physio in Milton looks at how you squat, hinge, lunge, rotate, and stabilize \u2014 not just where it hurts today.</span></p><p><span style=\"font-size: 16px;\">Our physiotherapists use this screen for athletes, active adults, and people returning from injury. The goal is to find the weak links that load joints and tissues the wrong way, then build a plan you can follow.</span></p><p><span style=\"font-size: 16px;\">If you want a clearer picture before starting a new sport, ramping up training, or returning after time off, this assessment gives you a structured starting point at our Milton clinic.</span></p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "d3ac145"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "37dba0e"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5bd4a37", "elType": "widget", "settings": {"skin": "cover", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "title": "Feel Better. Move Better. Live Fully.", "title_tag": "span", "description": "Trusted care that helps you move better and feel better. Call or book online now.", "description_tag": "span", "button": "Book Appointment Now", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "button_hover_background_color": "#8695D8", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "10", "left": "0", "isLinked": false}, "__globals__": {"button_hover_background_color": ""}, "ribbon_title": "Tonic Physio", "ribbon_horizontal_position": "right", "motion_fx_motion_fx_scrolling": "yes"}, "elements": [], "widgetType": "global", "templateID": "9260"}, {"id": "c285d5e", "elType": "widget", "settings": {"editor": "<div><h2>Who Should Book a Movement Screen</h2><p>This visit is useful if you keep getting the same niggle, feel unstable in sport, or want to train harder without guessing. It also helps before a return-to-sport block or after a long layoff.</p><ul><li>Recurring strains or \u201ctweaks\u201d that never fully settle</li><li>Return from injury, surgery, or time away from training</li><li>Performance goals where technique and capacity both matter</li></ul><p>We often see runners, gym-goers, field-sport athletes, and people whose work involves lifting, reaching, or long hours on their feet. You do not need to be in competitive sport to benefit.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "1809915"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0fea156"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5b7f42b", "elType": "widget", "settings": {"editor": "<div><h2>What Happens During the Assessment</h2><p>We start with your history, sport or work demands, and any previous injuries. Then we watch quality of movement under control and under load, rather than chasing a single \u201ctight\u201d muscle.</p><ul><li>Mobility of hips, ankles, shoulders, and spine</li><li>Core and hip control during single-leg and squat patterns</li><li>Painful versus restricted versus weak movement</li></ul><p>Findings are explained in plain language. You leave with priorities: what to restore, what to strengthen, and what to stop compensating for.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "92c6f74"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "7cb9ba2"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "84bd321", "elType": "widget", "settings": {"image": {"url": "https://tonicphysio.com/wp-content/uploads/2026/05/Functional-Movement-Assessment-balance-tonic-physio.jpg", "id": 12774, "size": "", "alt": "Functional movement and balance assessment at Tonic Physio Milton", "source": "library"}, "image_size": "full", "align": "center", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "20", "left": "0", "isLinked": false}}, "elements": [], "widgetType": "image"}, {"id": "3d8a957", "elType": "widget", "settings": {"editor": "<div><h2>What Your Assessment Covers</h2><p>These are the practical pieces we build into your plan:</p><ul><li>Full-body movement screen of squat, hinge, lunge, push, pull, and rotation.</li><li>Balance, control, and single-leg stability testing.</li><li>Identification of mobility restrictions and strength imbalances.</li><li>Sport- or job-specific tasks when they matter to your goals.</li><li>A written plan for training, rehab, or return to activity.</li><li>Clear next steps you can use in the gym, on the field, or at work.</li></ul></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "9f8a561", "elType": "widget", "settings": {"editor": "<div><h2>Why Have This Done at Tonic Physio</h2><p>A movement screen is only useful if it changes what you do next. We connect the findings to physiotherapy, a <a href=\"https://tonicphysio.com/physiotherapy-in-milton/return-to-sport-program/\">return to sport program</a>, or a <a href=\"https://tonicphysio.com/physiotherapy-in-milton/running-injury-assessment/\">running assessment</a> when that is the right path.</p><p>You get clinic-based testing in Milton with clinicians who treat these patterns every week \u2014 not a one-off checklist with no follow-up.</p><p>Book online or call the clinic if you want a baseline before your next training block.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "aef1606"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "49a15fd"}]}, "elements": [], "widgetType": "text-editor"}], "isInner": true}, {"id": "2f8706ae", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 25}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "20", "isLinked": false}, "background_overlay_opacity": {"unit": "px", "size": 1, "sizes": []}, "border_border": "none", "border_radius": {"unit": "px", "top": "20", "right": "20", "bottom": "20", "left": "20", "isLinked": true}, "_flex_size": "none", "css_classes": "service-sidebar__info service-sidebar__single", "hide_tablet": "hidden-tablet", "hide_mobile": "hidden-mobile", "__globals__": {"background_overlay_color": "globals/colors?id=0712892"}}, "elements": [{"id": "29b04101", "elType": "widget", "settings": {"title": "ALL SERVICES", "nav_menus": [{"_id": "4b4c20a", "nav_menu": "services-menu"}]}, "elements": [], "widgetType": "sidebar-nav"}, {"id": "6f1ddb3", "elType": "widget", "settings": {"skin": "cover", "layout": "above", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "graphic_element": "icon", "selected_icon": {"value": "icon icon-contact-form", "library": "ekiticons"}, "title": "MONDAY TO SATURDAY", "title_tag": "span", "description": "905-878-7775", "description_tag": "span", "button": "Book Appointment", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "vertical_position": "middle", "title_typography_typography": "custom", "title_typography_font_family": "Plus Jakarta Sans", "title_typography_font_size": {"unit": "px", "size": 26, "sizes": []}, "title_typography_font_weight": "600", "title_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "description_typography_typography": "custom", "description_typography_font_family": "Plus Jakarta Sans", "description_typography_font_weight": "600", "description_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "button_text_color": "#FFFFFF", "button_background_color": "#8695D8", "_margin": {"unit": "px", "top": "30", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "__globals__": {"title_typography_typography": "globals/typography?id=secondary", "description_typography_typography": "globals/typography?id=accent", "button_background_color": "globals/colors?id=secondary", "button_text_color": "globals/colors?id=0712892", "button_border_color": ""}, "link_click": "box"}, "elements": [], "widgetType": "global", "templateID": "10400"}], "isInner": true}], "isInner": false}, {"id": "4249e5c", "elType": "container", "settings": {"padding": {"unit": "px", "top": "50", "right": "0", "bottom": "50", "left": "0", "isLinked": ""}, "ekit_all_conditions_list": [{"_id": "ca7a7c3"}], "ekit_section_parallax_multi_items": [], "ekit_cursor_text_label": "Elementskit Cursor", "flex_direction": "column", "flex_align_items": "stretch", "flex_gap": {"size": 10, "column": "10", "row": "10", "unit": "px", "isLinked": true}, "padding_tablet": {"unit": "px", "top": "70", "right": "10", "bottom": "70", "left": "10", "isLinked": false}, "__globals__": {"background_color": "globals/colors?id=8891650", "background_color_b": ""}, "background_color_b": "#FFFFFF", "background_color": "#F3E5F2", "background_color_b_stop": {"unit": "%", "size": 28, "sizes": []}}, "elements": [{"id": "782bdc1", "elType": "widget", "settings": {"title": "FAQs About Functional Movement Assessment", "header_size": "h3", "title_color": "#000000", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "500", "typography_text_transform": "capitalize", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "e2e6de9"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "aa60a26"}]}, "elements": [], "widgetType": "heading"}, {"id": "bb966d3", "elType": "widget", "elements": [], "widgetType": "elementskit-accordion", "settings": {"ekit_accordion_items": [{"acc_title": "What is a functional movement assessment?", "acc_content": "<p>It is a structured physiotherapy exam of how you move in common patterns \u2014 squat, lunge, hinge, reach, and balance \u2014 to find restrictions, weakness, and compensations that raise injury risk or limit performance.</p>", "ekit_acc_is_active": "yes", "_id": "4081473"}, {"acc_title": "Do I need to be injured to book this?", "acc_content": "<p>No. Many people book it as a baseline before a season, a new gym program, or a return from time off. It is also useful when pain keeps returning in the same area.</p>", "ekit_acc_is_active": "", "_id": "858a430"}, {"acc_title": "How long is the appointment?", "acc_content": "<p>Plan for a standard physiotherapy assessment visit. Time is spent on history, movement testing, and a clear plan rather than a rushed screen.</p>", "ekit_acc_is_active": "", "_id": "00737ae"}, {"acc_title": "Is this the same as a running gait analysis?", "acc_content": "<p>They overlap, but a functional movement assessment looks at whole-body control. A <a href=\"https://tonicphysio.com/physiotherapy-in-milton/running-injury-assessment/\">running injury assessment</a> focuses more on running mechanics and load.</p>", "ekit_acc_is_active": "", "_id": "f54c22f"}, {"acc_title": "Will I get exercises the same day?", "acc_content": "<p>Yes. You should leave with the first priorities to work on, and a plan for follow-up if treatment or a supervised program is needed.</p>", "ekit_acc_is_active": "", "_id": "52a9e3e"}, {"acc_title": "Can this help me return to sport?", "acc_content": "<p>Yes. We use it to decide whether you are ready for higher-speed or sport-specific work, or whether mobility and strength still need to come first.</p>", "ekit_acc_is_active": "", "_id": "17c109d"}, {"acc_title": "Do I need a doctor\u2019s referral?", "acc_content": "<p>No referral is required to book at Tonic Physio. Some insurance plans still ask for one for reimbursement, so check your policy.</p>", "ekit_acc_is_active": "", "_id": "b13a33a"}, {"acc_title": "Where is the clinic?", "acc_content": "<p>Tonic Physio is at 100 Nipissing Rd #5 in Milton. Parking is available and we are open Monday to Saturday.</p>", "ekit_acc_is_active": "", "_id": "9d253e8"}], "ekit_accordian_faq_schema": "yes", "ekit_accordion_background_color": "#473872", "ekit_accordion_title_color_close": "#FFFFFF", "ekit_accordion_background_close_background": "classic", "ekit_accordion_background_close_color": "#473872", "__globals__": {"ekit_accordion_title_color_close": "globals/colors?id=0712892", "ekit_accordion_background_close_color": "globals/colors?id=accent", "ekit_accordion_content_background_color": "globals/colors?id=text", "ekit_accordion_content_color": "globals/colors?id=text", "ekit_accordion_content_typogr
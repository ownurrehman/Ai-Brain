[{"id": "9618aa7", "elType": "container", "settings": {"min_height": {"unit": "px", "size": 400, "sizes": []}, "background_background": "classic", "background_image": {"url": "https://tonicphysio.com/wp-content/uploads/2025/01/Physiotherapy-service.jpg", "id": 6309, "size": "", "alt": "Physiotherapy in Milton", "source": "library"}, "background_repeat": "no-repeat", "background_size": "cover", "background_overlay_image": {"url": "", "id": "", "size": "", "alt": "Physiotherapy in Milton", "source": "library"}, "background_overlay_position": "center center", "background_overlay_repeat": "no-repeat", "background_overlay_size": "cover", "__dynamic__": {"background_image": "[elementor-tag id=\"60793ad\" name=\"post-featured-image\" settings=\"%7B%7D\"]"}}, "elements": [], "isInner": false}, {"id": "5947bedb", "elType": "container", "settings": {"flex_direction": "row", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0"}, "flex_wrap_tablet": "wrap", "boxed_width": {"unit": "px", "size": 1300, "sizes": []}, "background_color": "#FFFFFF", "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "padding": {"unit": "px", "top": "50", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "__globals__": {"background_color": "", "background_color_b": "globals/colors?id=8891650"}}, "elements": [{"id": "14185019", "elType": "container", "settings": {"flex_direction": "column", "content_width": "full", "width": {"unit": "%", "size": 100}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "service-details__content", "margin_tablet": {"unit": "px", "top": "0", "right": "020", "bottom": "0", "left": "20", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "15", "bottom": "0", "left": "15", "isLinked": false}}, "elements": [{"id": "b2a709c", "elType": "widget", "settings": {"shortcode": "[wpseo_breadcrumb]"}, "elements": [], "widgetType": "global", "templateID": "11123"}, {"id": "b26ef64", "elType": "widget", "settings": {"title": "Return to Sport Program in Milton", "header_size": "h1", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "heading"}, {"id": "fb2de65", "elType": "widget", "settings": {"editor": "<div><p><span style=\"font-size: 16px;\">Getting back to sport is more than waiting until pain settles. A proper return to sport program rebuilds strength, power, confidence, and match-speed control so you are not guessing on the first game back.</span></p><p><span style=\"font-size: 16px;\">At Tonic Physio in Milton, we stage this work after sprains, muscle strains, post-surgical rehab, and overuse injuries. The plan is built around your sport, position, and the demands of practice versus competition.</span></p><p><span style=\"font-size: 16px;\">If you have been cleared medically but still feel hesitant, slow, or unstable, this program is designed to close that gap.</span></p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "d3ac145"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "37dba0e"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5bd4a37", "elType": "widget", "settings": {"skin": "cover", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "title": "Feel Better. Move Better. Live Fully.", "title_tag": "span", "description": "Trusted care that helps you move better and feel better. Call or book online now.", "description_tag": "span", "button": "Book Appointment Now", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "button_hover_background_color": "#8695D8", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "10", "left": "0", "isLinked": false}, "__globals__": {"button_hover_background_color": ""}, "ribbon_title": "Tonic Physio", "ribbon_horizontal_position": "right", "motion_fx_motion_fx_scrolling": "yes"}, "elements": [], "widgetType": "global", "templateID": "9260"}, {"id": "c285d5e", "elType": "widget", "settings": {"editor": "<div><h2>When a Staged Return Matters</h2><p>Pain-free daily walking is not the same as cutting, landing, or sprinting. Returning too early is one of the most common reasons injuries repeat.</p><ul><li>You feel fine in daily life but not at training speed</li><li>You have had the same injury more than once</li><li>A coach or surgeon has asked for a structured return plan</li></ul><p>We use this program after ankle and knee injuries, hamstring and calf strains, shoulder injuries in overhead athletes, and after a block of physiotherapy when the next step is sport, not just the clinic gym.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "1809915"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0fea156"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5b7f42b", "elType": "widget", "settings": {"editor": "<div><h2>What the Program Includes</h2><p>We start with a <a href=\"https://tonicphysio.com/physiotherapy-in-milton/functional-movement-assessment/\">functional movement assessment</a> and sport history, then progress through strength, reactive work, and drills that look like your sport.</p><ul><li>Strength and capacity for the injured region and the chain around it</li><li>Plyometrics and landing control when appropriate</li><li>Acceleration, deceleration, and change of direction</li><li>Sport-specific skill under fatigue</li></ul><p>Sessions are progressed only when quality and symptoms allow. You will know what \u201cready\u201d looks like for each stage rather than relying on a calendar alone.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "92c6f74"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "7cb9ba2"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "669e348", "elType": "widget", "settings": {"image": {"url": "https://tonicphysio.com/wp-content/uploads/2026/04/Return-to-Sport-Program-Sport-Specific-Drills-and-Linear-Mechanics-tonic-physio.jpg", "id": 12603, "size": "", "alt": "Sport-specific return to sport drills at Tonic Physio Milton", "source": "library"}, "image_size": "full", "align": "center", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "20", "left": "0", "isLinked": false}}, "elements": [], "widgetType": "image"}, {"id": "d4d93fd", "elType": "widget", "settings": {"editor": "<div><h2>How We Progress You Back to Sport</h2><p>These are the practical pieces we build into your plan:</p><ul><li>Clear criteria instead of \u201csee how it feels on game day.\u201d</li><li>Strength and power rebuilding after time off or injury.</li><li>Plyometric and change-of-direction work when you are ready.</li><li>Linear mechanics and sport-specific drills.</li><li>Load management so you do not spike volume too fast.</li><li>Communication with coaches or trainers when useful.</li></ul></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "9f8a561", "elType": "widget", "settings": {"editor": "<div><h2>Why Athletes Choose Tonic Physio</h2><p>You stay in a clinic that already treats the injury, rather than being handed a generic printout. We also treat <a href=\"https://tonicphysio.com/physiotherapy-in-milton/\">physiotherapy</a> needs that still sit underneath sport performance.</p><p>Milton athletes and active adults use this program to return to field sports, court sports, running, and gym training with a plan that matches real session demands.</p><p>Book an assessment to see which stage you are actually in \u2014 not which week you hoped to be in.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "aef1606"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "49a15fd"}]}, "elements": [], "widgetType": "text-editor"}], "isInner": true}, {"id": "2f8706ae", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 25}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "20", "isLinked": false}, "background_overlay_opacity": {"unit": "px", "size": 1, "sizes": []}, "border_border": "none", "border_radius": {"unit": "px", "top": "20", "right": "20", "bottom": "20", "left": "20", "isLinked": true}, "_flex_size": "none", "css_classes": "service-sidebar__info service-sidebar__single", "hide_tablet": "hidden-tablet", "hide_mobile": "hidden-mobile", "__globals__": {"background_overlay_color": "globals/colors?id=0712892"}}, "elements": [{"id": "29b04101", "elType": "widget", "settings": {"title": "ALL SERVICES", "nav_menus": [{"_id": "4b4c20a", "nav_menu": "services-menu"}]}, "elements": [], "widgetType": "sidebar-nav"}, {"id": "6f1ddb3", "elType": "widget", "settings": {"skin": "cover", "layout": "above", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "graphic_element": "icon", "selected_icon": {"value": "icon icon-contact-form", "library": "ekiticons"}, "title": "MONDAY TO SATURDAY", "title_tag": "span", "description": "905-878-7775", "description_tag": "span", "button": "Book Appointment", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "vertical_position": "middle", "title_typography_typography": "custom", "title_typography_font_family": "Plus Jakarta Sans", "title_typography_font_size": {"unit": "px", "size": 26, "sizes": []}, "title_typography_font_weight": "600", "title_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "description_typography_typography": "custom", "description_typography_font_family": "Plus Jakarta Sans", "description_typography_font_weight": "600", "description_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "button_text_color": "#FFFFFF", "button_background_color": "#8695D8", "_margin": {"unit": "px", "top": "30", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "__globals__": {"title_typography_typography": "globals/typography?id=secondary", "description_typography_typography": "globals/typography?id=accent", "button_background_color": "globals/colors?id=secondary", "button_text_color": "globals/colors?id=0712892", "button_border_color": ""}, "link_click": "box"}, "elements": [], "widgetType": "global", "templateID": "10400"}], "isInner": true}], "isInner": false}, {"id": "4249e5c", "elType": "container", "settings": {"padding": {"unit": "px", "top": "50", "right": "0", "bottom": "50", "left": "0", "isLinked": ""}, "ekit_all_conditions_list": [{"_id": "ca7a7c3"}], "ekit_section_parallax_multi_items": [], "ekit_cursor_text_label": "Elementskit Cursor", "flex_direction": "column", "flex_align_items": "stretch", "flex_gap": {"size": 10, "column": "10", "row": "10", "unit": "px", "isLinked": true}, "padding_tablet": {"unit": "px", "top": "70", "right": "10", "bottom": "70", "left": "10", "isLinked": false}, "__globals__": {"background_color": "globals/colors?id=8891650", "background_color_b": ""}, "background_color_b": "#FFFFFF", "background_color": "#F3E5F2", "background_color_b_stop": {"unit": "%", "size": 28, "sizes": []}}, "elements": [{"id": "782bdc1", "elType": "widget", "settings": {"title": "FAQs About Our Return to Sport Program", "header_size": "h3", "title_color": "#000000", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "500", "typography_text_transform": "capitalize", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "e2e6de9"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "aa60a26"}]}, "elements": [], "widgetType": "heading"}, {"id": "81b9b42", "elType": "widget", "elements": [], "widgetType": "elementskit-accordion", "settings": {"ekit_accordion_items": [{"acc_title": "When can I start a return to sport program?", "acc_content": "<p>Once acute pain and swelling are under control and you can complete basic strength and movement tests without a flare. We decide the start point at assessment, not from a generic timeline.</p>", "ekit_acc_is_active": "yes", "_id": "9066799"}, {"acc_title": "Is this only for competitive athletes?", "acc_content": "<p>No. Recreational players, runners, and gym athletes use the same staged approach. The drills change; the principle does not.</p>", "ekit_acc_is_active": "", "_id": "fe77846"}, {"acc_title": "How is this different from regular physiotherapy?", "acc_content": "<p>Physiotherapy restores movement and daily function. Return to sport adds speed, power, and sport-specific load so you can train and compete, not just walk without pain.</p>", "ekit_acc_is_active": "", "_id": "dedf953"}, {"acc_title": "Do you work with my coach?", "acc_content": "<p>When it helps, yes. We can share stage goals and restrictions so practice load does not undo clinic progress.</p>", "ekit_acc_is_active": "", "_id": "1c04a28"}, {"acc_title": "What if I still have pain?", "acc_content": "<p>Then we treat that first or in parallel. Pushing sport drills on an irritable injury usually delays return.</p>", "ekit_acc_is_active": "", "_id": "80685db"}, {"acc_title": "How many sessions will I need?", "acc_content": "<p>It depends on the injury, how long you have been away, and your sport. Some people need a short block; others need several stages over weeks.</p>", "ekit_acc_is_active": "", "_id": "fddd65a"}, {"acc_title": "Can I keep training while I am in the program?", "acc_content": "<p>Often yes, with modified load. We will tell you what to keep, what to drop, and what to delay.</p>", "ekit_acc_is_active": "", "_id": "eca754b"}, {"acc_title": "Do I need a referral?", "acc_content": "<p>No. Book directly at Tonic Physio. Check your insurance if they require a referral for coverage.</p>", "ekit_acc_is_active": "", "_id": "a57228a"}], "ekit_accordian_faq_schema": "yes", "ekit_accordion_background_color": "#473872", "ekit_accordion_title_color_close": "#FFFFFF", "ekit_accordion_background_close_background": "classic", "ekit_accordion_background_close_color": "#473872", "__globals__": {"ekit_accordion_title_color_close": "globals/colors?id=0712892", "ekit_accordion_background_close_color": "globals/colors?id=accent", "ekit_accordion_content_background_color": "globals/colors?id=text", "ekit_accordion_content_color": "globals/colors?id=text", "ekit_accordion_content_typography_typography": "globals/typography?id=text"}, "ekit_accordion_content_border_radious": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}, "ekit_accordion_content_padding": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}}}], "isInner": false}, {"id": "60186c47", "elType": "container", "settings": {"flex_directio
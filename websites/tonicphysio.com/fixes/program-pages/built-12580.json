", "right": "15", "bottom": "0", "left": "15", "isLinked": false}}, "elements": [{"id": "b2a709c", "elType": "widget", "settings": {"shortcode": "[wpseo_breadcrumb]"}, "elements": [], "widgetType": "global", "templateID": "11123"}, {"id": "b26ef64", "elType": "widget", "settings": {"title": "Nutrition Coaching in Milton", "header_size": "h1", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "heading"}, {"id": "fb2de65", "elType": "widget", "settings": {"editor": "<div><p><span style=\"font-size: 16px;\">Food will not replace physiotherapy, but it does affect how you recover, train, and feel through a work week. Nutrition coaching at Tonic Physio in Milton is practical: meals you can cook, pack, and repeat \u2014 not a rigid plan that collapses on a busy Thursday.</span></p><p><span style=\"font-size: 16px;\">We work with people recovering from injury, managing energy for sport or shift work, and trying to support an anti-inflammatory pattern without cutting out entire food groups for no reason.</span></p><p><span style=\"font-size: 16px;\">If you already attend the clinic for physio, coaching can sit alongside that care so your rehab and your plate are not pulling in different directions.</span></p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "d3ac145"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "37dba0e"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5bd4a37", "elType": "widget", "settings": {"skin": "cover", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "title": "Feel Better. Move Better. Live Fully.", "title_tag": "span", "description": "Trusted care that helps you move better and feel better. Call or book online now.", "description_tag": "span", "button": "Book Appointment Now", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "button_hover_background_color": "#8695D8", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "10", "left": "0", "isLinked": false}, "__globals__": {"button_hover_background_color": ""}, "ribbon_title": "Tonic Physio", "ribbon_horizontal_position": "right", "motion_fx_motion_fx_scrolling": "yes"}, "elements": [], "widgetType": "global", "templateID": "9260"}, {"id": "c285d5e", "elType": "widget", "settings": {"editor": "<div><h2>Who This Is For</h2><p>This is a good fit if you are in rehab and unsure what to eat around sessions, if training has increased, or if you keep starting over with diets that are too strict to keep.</p><ul><li>Injury recovery and return to activity</li><li>Busy workdays with skipped meals and late-night catch-up eating</li><li>Athletes who need more consistent fueling, not more rules</li></ul><p>It is not a medical nutrition clinic for complex disease management. If you have a condition that needs a registered dietitian or physician-led care, we will say so and keep the advice within a sensible scope.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "1809915"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0fea156"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5b7f42b", "elType": "widget", "settings": {"editor": "<div><h2>What You Work On Together</h2><p>Sessions focus on your actual week: breakfasts you will eat, lunches you can pack, and how to handle takeout or family meals without a full reset every Monday.</p><ul><li>A realistic weekly meal pattern</li><li>Recovery-friendly options around physiotherapy or training</li><li>How to adjust on travel, overtime, or game weeks</li></ul><p>We may talk about protein around rehab sessions, hydration, fibre, and reducing ultra-processed defaults \u2014 always in the context of what you already like and can afford.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "92c6f74"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "7cb9ba2"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "fe4ad7f", "elType": "widget", "settings": {"image": {"url": "https://tonicphysio.com/wp-content/uploads/2026/04/Nutrition-Coaching-Weekly-Meal-Plan-tonic-physio.jpg", "id": 12644, "size": "", "alt": "Nutrition coaching meal planning at Tonic Physio Milton", "source": "library"}, "image_size": "full", "align": "center", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "20", "left": "0", "isLinked": false}}, "elements": [], "widgetType": "image"}, {"id": "75810fb", "elType": "widget", "settings": {"editor": "<div><h2>What Nutrition Coaching Can Help With</h2><p>These are the practical pieces we build into your plan:</p><ul><li>Fueling around physiotherapy, training, and workdays.</li><li>Practical meal structure instead of extreme diets.</li><li>Support for recovery after injury or surgery.</li><li>Guidance when inflammation, energy, or sleep are off.</li><li>Simple shopping and prep habits that fit a busy week.</li><li>Coordination with your physiotherapy goals at the same clinic.</li></ul></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "9f8a561", "elType": "widget", "settings": {"editor": "<div><h2>Why Have Nutrition Support at a Physio Clinic</h2><p>Your coach understands you are also in the clinic for <a href=\"https://tonicphysio.com/physiotherapy-in-milton/\">physiotherapy</a>, a <a href=\"https://tonicphysio.com/physiotherapy-in-milton/return-to-sport-program/\">return to sport program</a>, or workplace recovery. Advice can match that load rather than fighting it.</p><p>You still get the same Milton location, booking, and team. Start with an appointment and bring a typical day of eating \u2014 photos on your phone are enough.</p><p>Book online if you want a plan you can follow next week, not next January.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "aef1606"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "49a15fd"}]}, "elements": [], "widgetType": "text-editor"}], "isInner": true}, {"id": "2f8706ae", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 25}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "20", "isLinked": false}, "background_overlay_opacity": {"unit": "px", "size": 1, "sizes": []}, "border_border": "none", "border_radius": {"unit": "px", "top": "20", "right": "20", "bottom": "20", "left": "20", "isLinked": true}, "_flex_size": "none", "css_classes": "service-sidebar__info service-sidebar__single", "hide_tablet": "hidden-tablet", "hide_mobile": "hidden-mobile", "__globals__": {"background_overlay_color": "globals/colors?id=0712892"}}, "elements": [{"id": "29b04101", "elType": "widget", "settings": {"title": "ALL SERVICES", "nav_menus": [{"_id": "4b4c20a", "nav_menu": "services-menu"}]}, "elements": [], "widgetType": "sidebar-nav"}, {"id": "6f1ddb3", "elType": "widget", "settings": {"skin": "cover", "layout": "above", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "graphic_element": "icon", "selected_icon": {"value": "icon icon-contact-form", "library": "ekiticons"}, "title": "MONDAY TO SATURDAY", "title_tag": "span", "description": "905-878-7775", "description_tag": "span", "button": "Book Appointment", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "vertical_position": "middle", "title_typography_typography": "custom", "title_typography_font_family": "Plus Jakarta Sans", "title_typography_font_size": {"unit": "px", "size": 26, "sizes": []}, "title_typography_font_weight": "600", "title_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "description_typography_typography": "custom", "description_typography_font_family": "Plus Jakarta Sans", "description_typography_font_weight": "600", "description_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "button_text_color": "#FFFFFF", "button_background_color": "#8695D8", "_margin": {"unit": "px", "top": "30", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "__globals__": {"title_typography_typography": "globals/typography?id=secondary", "description_typography_typography": "globals/typography?id=accent", "button_background_color": "globals/colors?id=secondary", "button_text_color": "globals/colors?id=0712892", "button_border_color": ""}, "link_click": "box"}, "elements": [], "widgetType": "global", "templateID": "10400"}], "isInner": true}], "isInner": false}, {"id": "4249e5c", "elType": "container", "settings": {"padding": {"unit": "px", "top": "50", "right": "0", "bottom": "50", "left": "0", "isLinked": ""}, "ekit_all_conditions_list": [{"_id": "ca7a7c3"}], "ekit_section_parallax_multi_items": [], "ekit_cursor_text_label": "Elementskit Cursor", "flex_direction": "column", "flex_align_items": "stretch", "flex_gap": {"size": 10, "column": "10", "row": "10", "unit": "px", "isLinked": true}, "padding_tablet": {"unit": "px", "top": "70", "right": "10", "bottom": "70", "left": "10", "isLinked": false}, "__globals__": {"background_color": "globals/colors?id=8891650", "background_color_b": ""}, "background_color_b": "#FFFFFF", "background_color": "#F3E5F2", "background_color_b_stop": {"unit": "%", "size": 28, "sizes": []}}, "elements": [{"id": "782bdc1", "elType": "widget", "settings": {"title": "FAQs About Nutrition Coaching", "header_size": "h3", "title_color": "#000000", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "500", "typography_text_transform": "capitalize", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "e2e6de9"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "aa60a26"}]}, "elements": [], "widgetType": "heading"}, {"id": "4677076", "elType": "widget", "elements": [], "widgetType": "elementskit-accordion", "settings": {"ekit_accordion_items": [{"acc_title": "Is this the same as seeing a dietitian?", "acc_content": "<p>Not always. Nutrition coaching here is practical education and habit support alongside physiotherapy. Some medical conditions need a registered dietitian or your physician. We will tell you if that is the better next step.</p>", "ekit_acc_is_active": "yes", "_id": "79105d8"}, {"acc_title": "Do I have to follow a strict meal plan?", "acc_content": "<p>No. We build around foods you already eat and the time you actually have. Strict plans that you cannot keep are not the goal.</p>", "ekit_acc_is_active": "", "_id": "50fff8e"}, {"acc_title": "Can nutrition help my injury recover faster?", "acc_content": "<p>Adequate protein, energy, sleep, and hydration support tissue repair. Food is one part of recovery, not a substitute for assessment and rehab.</p>", "ekit_acc_is_active": "", "_id": "4de8d76"}, {"acc_title": "Will you sell me supplements?", "acc_content": "<p>The focus is food first. If a supplement is discussed, it is optional and should not replace meals or prescribed care.</p>", "ekit_acc_is_active": "", "_id": "6181aac"}, {"acc_title": "How many sessions do people book?", "acc_content": "<p>Some people need a single planning session. Others prefer a short follow-up block while they change weekday habits.</p>", "ekit_acc_is_active": "", "_id": "243ddab"}, {"acc_title": "Can I do this while I am already in physiotherapy?", "acc_content": "<p>Yes. That is often the best time, because training and rehab load are already on the calendar.</p>", "ekit_acc_is_active": "", "_id": "4e73c9a"}, {"acc_title": "Do you help with sports nutrition?", "acc_content": "<p>We can help recreational and club athletes eat more consistently around training. High-performance sport nutrition may still need a specialist.</p>", "ekit_acc_is_active": "", "_id": "e09c0b7"}, {"acc_title": "How do I book?", "acc_content": "<p>Book through Jane or call Tonic Physio in Milton. Mention nutrition coaching when you schedule.</p>", "ekit_acc_is_active": "", "_id": "520056e"}], "ekit_accordian_faq_schema": "yes", "ekit_accordion_background_color": "#473872", "ekit_accordion_title_color_close": "#FFFFFF", "ekit_accordion_background_close_background": "classic", "ekit_accordion_background_close_color": "#473872", "__globals__": {"ekit_accordion_title_color_close": "globals/colors?id=0712892", "ekit_accordion_background_close_color": "globals/colors?id=accent", "ekit_accordion_content_background_color": "globals/colors?id=text", "ekit_accordion_content_color": "globals/colors?id=text", "ekit_accordion_content_typography_typography": "globals/typography?id=text"}, "ekit_accordion_content_border_radious": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}, "ekit_accordion_content_padding": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}}}], "isInner": false}, {"id": "60186c47", "elType": "container", "settings": {"flex_direction": "column", "content_widt
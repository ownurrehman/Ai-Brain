[{"id": "9618aa7", "elType": "container", "settings": {"min_height": {"unit": "px", "size": 400, "sizes": []}, "background_background": "classic", "background_image": {"url": "https://tonicphysio.com/wp-content/uploads/2025/01/Physiotherapy-service.jpg", "id": 6309, "size": "", "alt": "Physiotherapy in Milton", "source": "library"}, "background_repeat": "no-repeat", "background_size": "cover", "background_overlay_image": {"url": "", "id": "", "size": "", "alt": "Physiotherapy in Milton", "source": "library"}, "background_overlay_position": "center center", "background_overlay_repeat": "no-repeat", "background_overlay_size": "cover", "__dynamic__": {"background_image": "[elementor-tag id=\"60793ad\" name=\"post-featured-image\" settings=\"%7B%7D\"]"}}, "elements": [], "isInner": false}, {"id": "5947bedb", "elType": "container", "settings": {"flex_direction": "row", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0"}, "flex_wrap_tablet": "wrap", "boxed_width": {"unit": "px", "size": 1300, "sizes": []}, "background_color": "#FFFFFF", "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "padding": {"unit": "px", "top": "50", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "__globals__": {"background_color": "", "background_color_b": "globals/colors?id=8891650"}}, "elements": [{"id": "14185019", "elType": "container", "settings": {"flex_direction": "column", "content_width": "full", "width": {"unit": "%", "size": 100}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "service-details__content", "margin_tablet": {"unit": "px", "top": "0", "right": "020", "bottom": "0", "left": "20", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "15", "bottom": "0", "left": "15", "isLinked": false}}, "elements": [{"id": "b2a709c", "elType": "widget", "settings": {"shortcode": "[wpseo_breadcrumb]"}, "elements": [], "widgetType": "global", "templateID": "11123"}, {"id": "b26ef64", "elType": "widget", "settings": {"title": "Work Injury Physiotherapy in Milton", "header_size": "h1", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "heading"}, {"id": "fb2de65", "elType": "widget", "settings": {"editor": "<div><p><span style=\"font-size: 16px;\">A work injury does not have to wait until you cannot finish a shift. Early physiotherapy for lifting injuries, slips, repetitive strain, and postural overload can shorten time off and reduce the chance the problem becomes chronic.</span></p><p><span style=\"font-size: 16px;\">Tonic Physio in Milton treats workplace injuries for people on WSIB claims and for those using extended health benefits or paying privately. Care is built around the job you need to return to \u2014 warehouse, trades, office, health care, or driving.</span></p><p><span style=\"font-size: 16px;\">If you already have a WSIB claim, see our <a href=\"https://tonicphysio.com/wsib-care-programs/\">WSIB Care Programs</a> page as well. This page is for the broader work-injury pathway, including the first days after an incident.</span></p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "d3ac145"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "37dba0e"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5bd4a37", "elType": "widget", "settings": {"skin": "cover", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "title": "Feel Better. Move Better. Live Fully.", "title_tag": "span", "description": "Trusted care that helps you move better and feel better. Call or book online now.", "description_tag": "span", "button": "Book Appointment Now", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "button_hover_background_color": "#8695D8", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "10", "left": "0", "isLinked": false}, "__globals__": {"button_hover_background_color": ""}, "ribbon_title": "Tonic Physio", "ribbon_horizontal_position": "right", "motion_fx_motion_fx_scrolling": "yes"}, "elements": [], "widgetType": "global", "templateID": "9260"}, {"id": "c285d5e", "elType": "widget", "settings": {"editor": "<div><h2>Common Workplace Injuries We Treat</h2><p>Most work injuries we see are musculoskeletal: backs from lifting, shoulders from overhead work, wrists from tools or typing, and knees or ankles from slips and uneven ground.</p><ul><li>Low back and neck strain from lifting or prolonged sitting</li><li>Shoulder and elbow overload from repetitive or overhead tasks</li><li>Slips, trips, and falls</li><li>Gradual onset repetitive strain</li></ul><p>Repetitive strain can look \u201csmall\u201d until it stops you gripping, lifting, or sitting through a full day. Those cases still need a proper exam and a plan, not just rest until Monday.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "1809915"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0fea156"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5b7f42b", "elType": "widget", "settings": {"editor": "<div><h2>Return to Work, Not Just Pain Relief</h2><p>We treat pain, but we also test the tasks your job requires: lifting, carrying, reaching, standing, and sitting tolerance. That is how we decide when modified duties make sense.</p><ul><li>Job-demand focused exercise</li><li>Advice on temporary modifications</li><li>Progress reviews you can share with your workplace or case manager</li></ul><p>When a WSIB program of care applies, we follow that structure. When it does not, we still use the same principle: restore capacity for work, then build it up.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "92c6f74"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "7cb9ba2"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "d40ba19", "elType": "widget", "settings": {"image": {"url": "https://tonicphysio.com/wp-content/uploads/2026/05/Work-Injuries-initial-assesment-tonic-physio.jpg", "id": 12752, "size": "", "alt": "Work injury physiotherapy assessment at Tonic Physio Milton", "source": "library"}, "image_size": "full", "align": "center", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "20", "left": "0", "isLinked": false}}, "elements": [], "widgetType": "image"}, {"id": "a945ab8", "elType": "widget", "settings": {"editor": "<div><h2>How We Help You Get Back to Work</h2><p>These are the practical pieces we build into your plan:</p><ul><li>Assessment tied to your actual job tasks, not just the painful spot.</li><li>Treatment for sprains, strains, back and neck injuries, and overuse.</li><li>Graded strengthening for lifting, reaching, and standing tolerance.</li><li>Return-to-work planning with modified duties when needed.</li><li>WSIB-related care when your claim is approved.</li><li>Clear home exercises you can do around shift work.</li></ul></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "9f8a561", "elType": "widget", "settings": {"editor": "<div><h2>Why Injured Workers Come to Tonic Physio</h2><p>You get a Milton clinic that already handles WSIB reporting when needed, plus everyday work injuries that never become a claim. We also offer <a href=\"https://tonicphysio.com/physiotherapy-in-milton/workplace-ergonomics-assessment/\">workplace ergonomics assessments</a> when the job setup is part of the problem.</p><p>Appointments are available Monday to Saturday so shift workers can attend without missing a full week of care.</p><p>Book promptly after an incident when you can \u2014 earlier assessment usually means a simpler plan.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "aef1606"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "49a15fd"}]}, "elements": [], "widgetType": "text-editor"}], "isInner": true}, {"id": "2f8706ae", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 25}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "20", "isLinked": false}, "background_overlay_opacity": {"unit": "px", "size": 1, "sizes": []}, "border_border": "none", "border_radius": {"unit": "px", "top": "20", "right": "20", "bottom": "20", "left": "20", "isLinked": true}, "_flex_size": "none", "css_classes": "service-sidebar__info service-sidebar__single", "hide_tablet": "hidden-tablet", "hide_mobile": "hidden-mobile", "__globals__": {"background_overlay_color": "globals/colors?id=0712892"}}, "elements": [{"id": "29b04101", "elType": "widget", "settings": {"title": "ALL SERVICES", "nav_menus": [{"_id": "4b4c20a", "nav_menu": "services-menu"}]}, "elements": [], "widgetType": "sidebar-nav"}, {"id": "6f1ddb3", "elType": "widget", "settings": {"skin": "cover", "layout": "above", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "graphic_element": "icon", "selected_icon": {"value": "icon icon-contact-form", "library": "ekiticons"}, "title": "MONDAY TO SATURDAY", "title_tag": "span", "description": "905-878-7775", "description_tag": "span", "button": "Book Appointment", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "vertical_position": "middle", "title_typography_typography": "custom", "title_typography_font_family": "Plus Jakarta Sans", "title_typography_font_size": {"unit": "px", "size": 26, "sizes": []}, "title_typography_font_weight": "600", "title_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "description_typography_typography": "custom", "description_typography_font_family": "Plus Jakarta Sans", "description_typography_font_weight": "600", "description_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "button_text_color": "#FFFFFF", "button_background_color": "#8695D8", "_margin": {"unit": "px", "top": "30", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "__globals__": {"title_typography_typography": "globals/typography?id=secondary", "description_typography_typography": "globals/typography?id=accent", "button_background_color": "globals/colors?id=secondary", "button_text_color": "globals/colors?id=0712892", "button_border_color": ""}, "link_click": "box"}, "elements": [], "widgetType": "global", "templateID": "10400"}], "isInner": true}], "isInner": false}, {"id": "4249e5c", "elType": "container", "settings": {"padding": {"unit": "px", "top": "50", "right": "0", "bottom": "50", "left": "0", "isLinked": ""}, "ekit_all_conditions_list": [{"_id": "ca7a7c3"}], "ekit_section_parallax_multi_items": [], "ekit_cursor_text_label": "Elementskit Cursor", "flex_direction": "column", "flex_align_items": "stretch", "flex_gap": {"size": 10, "column": "10", "row": "10", "unit": "px", "isLinked": true}, "padding_tablet": {"unit": "px", "top": "70", "right": "10", "bottom": "70", "left": "10", "isLinked": false}, "__globals__": {"background_color": "globals/colors?id=8891650", "background_color_b": ""}, "background_color_b": "#FFFFFF", "background_color": "#F3E5F2", "background_color_b_stop": {"unit": "%", "size": 28, "sizes": []}}, "elements": [{"id": "782bdc1", "elType": "widget", "settings": {"title": "FAQs About Work Injury Care", "header_size": "h3", "title_color": "#000000", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "500", "typography_text_transform": "capitalize", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "e2e6de9"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "aa60a26"}]}, "elements": [], "widgetType": "heading"}, {"id": "59e9807", "elType": "widget", "elements": [], "widgetType": "elementskit-accordion", "settings": {"ekit_accordion_items": [{"acc_title": "Should I see physio after a workplace incident?", "acc_content": "<p>Yes, especially if pain, swelling, or limited movement lasts more than a day or two, or if you cannot do your normal job tasks. Early care helps you document the injury and start the right loading.</p>", "ekit_acc_is_active": "yes", "_id": "115df19"}, {"acc_title": "Is this the same as WSIB Care Programs?", "acc_content": "<p>WSIB programs are a specific funded pathway after a claim is approved. This page covers work injuries more broadly, including private and benefits-covered care. Approved claims are treated through our <a href=\"https://tonicphysio.com/wsib-care-programs/\">WSIB Care Programs</a>.</p>", "ekit_acc_is_active": "", "_id": "c21f6f7"}, {"acc_title": "Do I need to report the injury to my employer?", "acc_content": "<p>Yes. Tell your employer as soon as you can. That protects you if the injury later needs time off or a WSIB claim.</p>", "ekit_acc_is_active": "", "_id": "97e62ea"}, {"acc_title": "Can I come in if I am still working modified duties?", "acc_content": "<p>Yes. Many people attend while on modified work. We plan sessions around your remaining job tasks.</p>", "ekit_acc_is_active": "", "_id": "4394e62"}, {"acc_title": "What should I bring to the first visit?", "acc_content": "<p>A list of job tasks, any incident reports, claim numbers if you have them, and imaging or doctor notes if they exist.</p>", "ekit_acc_is_active": "", "_id": "d5cd6a5"}, {"acc_title": "Will you tell me to stay off work?", "acc_content": "<p>Only if the job is unsafe given your current capacity. The usual goal is a graded return, not prolonged rest.</p>", "ekit_acc_is_active": "", "_id": "4541e26"}, {"acc_title": "Do you treat office workers as well as trades?", "acc_content": "<p>Yes. Desk-related neck, back, and arm pain is a work injury too. Ergonomic advice is part of that care.</p>", "ekit_acc_is_active": "", "_id": "eb149ed"}, {"acc_title": "How do I book?", "acc_content": "<p>Book online through Jane or call 905-878-7775. Mention that it is a work injury so we can allow enough time for the first visit.</p>", "ekit_acc_is_active": "", "_id": "520056e"}], "ekit_accordian_faq_schema": "yes", "ekit_accordion_background_color": "#473872", "ekit_accordion_title_color_close": "#FFFFFF", "ekit_accordion_background_close_background": "classic", "ekit_accordion_background_close_color": "#473872", "__globals__": {"ekit_accordion_title_color_close": "globals/colors?id=0712892", "ekit_accordion_background_close_color": "globals/colors?id=accent", "ekit_accordion_content_background_color": "globals/colors?id=text", "ekit_accordion_content_color": "globals/colors?id=text", "ekit_accordion_content_typography_typography": "globals/typography?id=text"}, "ekit_accordion_content_border_radious": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isL
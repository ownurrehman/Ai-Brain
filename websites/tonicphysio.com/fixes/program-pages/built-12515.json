[{"id": "9618aa7", "elType": "container", "settings": {"min_height": {"unit": "px", "size": 400, "sizes": []}, "background_background": "classic", "background_image": {"url": "https://tonicphysio.com/wp-content/uploads/2025/01/Physiotherapy-service.jpg", "id": 6309, "size": "", "alt": "Physiotherapy in Milton", "source": "library"}, "background_repeat": "no-repeat", "background_size": "cover", "background_overlay_image": {"url": "", "id": "", "size": "", "alt": "Physiotherapy in Milton", "source": "library"}, "background_overlay_position": "center center", "background_overlay_repeat": "no-repeat", "background_overlay_size": "cover", "__dynamic__": {"background_image": "[elementor-tag id=\"60793ad\" name=\"post-featured-image\" settings=\"%7B%7D\"]"}}, "elements": [], "isInner": false}, {"id": "5947bedb", "elType": "container", "settings": {"flex_direction": "row", "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0"}, "flex_wrap_tablet": "wrap", "boxed_width": {"unit": "px", "size": 1300, "sizes": []}, "background_color": "#FFFFFF", "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "padding": {"unit": "px", "top": "50", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "__globals__": {"background_color": "", "background_color_b": "globals/colors?id=8891650"}}, "elements": [{"id": "14185019", "elType": "container", "settings": {"flex_direction": "column", "content_width": "full", "width": {"unit": "%", "size": 100}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "service-details__content", "margin_tablet": {"unit": "px", "top": "0", "right": "020", "bottom": "0", "left": "20", "isLinked": false}, "margin_mobile": {"unit": "px", "top": "0", "right": "15", "bottom": "0", "left": "15", "isLinked": false}}, "elements": [{"id": "b2a709c", "elType": "widget", "settings": {"shortcode": "[wpseo_breadcrumb]"}, "elements": [], "widgetType": "global", "templateID": "11123"}, {"id": "b26ef64", "elType": "widget", "settings": {"title": "Workplace Ergonomics Assessment in Milton", "header_size": "h1", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "heading"}, {"id": "fb2de65", "elType": "widget", "settings": {"editor": "<div><p><span style=\"font-size: 16px;\">Long hours at a desk, repetitive tasks, and a poor workstation add up. Neck pain, headaches, shoulder tension, and low back stiffness are often the result of setup and habits \u2014 not a \u201cweak core\u201d you need to live with.</span></p><p><span style=\"font-size: 16px;\">A workplace ergonomics assessment at Tonic Physio in Milton looks at how you sit, stand, reach, and lift, then gives you a short list of changes that matter. We treat the tissues that are already sore and reduce the load that keeps irritating them.</span></p><p><span style=\"font-size: 16px;\">This is useful for office teams, hybrid workers, and people whose job is not a desk but still has a repeated posture or lift.</span></p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "d3ac145"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "37dba0e"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5bd4a37", "elType": "widget", "settings": {"skin": "cover", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "title": "Feel Better. Move Better. Live Fully.", "title_tag": "span", "description": "Trusted care that helps you move better and feel better. Call or book online now.", "description_tag": "span", "button": "Book Appointment Now", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "button_hover_background_color": "#8695D8", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "10", "left": "0", "isLinked": false}, "__globals__": {"button_hover_background_color": ""}, "ribbon_title": "Tonic Physio", "ribbon_horizontal_position": "right", "motion_fx_motion_fx_scrolling": "yes"}, "elements": [], "widgetType": "global", "templateID": "9260"}, {"id": "c285d5e", "elType": "widget", "settings": {"editor": "<div><h2>Desk and Hybrid Work Setups</h2><p>Most desk problems come from a screen that sits too low, a chair that does not support the low back, and a mouse that sits too far forward. Laptops used for hours without a stand and external keyboard are a common source of neck pain.</p><ul><li>Monitor at or slightly below eye level</li><li>Elbows near 90 degrees, wrists closer to neutral</li><li>Feet supported, lumbar curve supported</li><li>Movement breaks every 30\u201360 minutes</li></ul><p>We will show you target positions for the monitor, elbows, and feet, and how to alternate sitting and standing if you have a sit-stand desk. Standing all day is not the fix either.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "1809915"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0fea156"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5b7f42b", "elType": "widget", "settings": {"editor": "<div><h2>When the Job Is Not a Desk</h2><p>Trades, warehousing, health care, and driving have their own ergonomic problems: repeated flexion, awkward reaches, and tools held too far from the body. We assess those tasks the same way \u2014 reduce the load, then condition the tissues that still have to do the work.</p><ul><li>Task analysis of your real lifts and reaches</li><li>Simple tool and posture changes</li><li>Strength and mobility work for the overloaded region</li></ul><p>If pain is already limiting your job, combine this visit with <a href=\"https://tonicphysio.com/physiotherapy-in-milton/work-injuries/\">work injury physiotherapy</a> rather than only changing the chair.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "92c6f74"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "7cb9ba2"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "3cb6f08", "elType": "widget", "settings": {"image": {"url": "https://tonicphysio.com/wp-content/uploads/2026/08/workplace-ergonomics-desk-setup-milton.jpg", "id": 13463, "size": "", "alt": "Ergonomic desk setup assessment in Milton at Tonic Physio", "source": "library"}, "image_size": "full", "align": "center", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "20", "left": "0", "isLinked": false}}, "elements": [], "widgetType": "image"}, {"id": "45adb50", "elType": "widget", "settings": {"editor": "<div><h2>What We Review in an Ergonomics Visit</h2><p>These are the practical pieces we build into your plan:</p><ul><li>Chair, desk, screen, keyboard, and mouse setup.</li><li>Laptop and hybrid-work setups that cause neck strain.</li><li>Lifting, reaching, and standing tasks for non-desk jobs.</li><li>Breaks and movement you can actually do on a shift.</li><li>A short list of changes ranked by impact.</li><li>Exercises for the tissues already irritated by the job.</li></ul></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "9f8a561", "elType": "widget", "settings": {"editor": "<div><h2>Why Book This at Tonic Physio</h2><p>You get a clinician who treats the pain and the setup. A checklist without treatment often fails; treatment without changing the desk often fails too.</p><p>We can also support employers who want a practical session for staff, not a binder that never gets used.</p><p>Bring photos of your workstation if you cannot be assessed on site. Many hybrid workers do this successfully.</p></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "aef1606"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "49a15fd"}]}, "elements": [], "widgetType": "text-editor"}], "isInner": true}, {"id": "2f8706ae", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 25}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "20", "isLinked": false}, "background_overlay_opacity": {"unit": "px", "size": 1, "sizes": []}, "border_border": "none", "border_radius": {"unit": "px", "top": "20", "right": "20", "bottom": "20", "left": "20", "isLinked": true}, "_flex_size": "none", "css_classes": "service-sidebar__info service-sidebar__single", "hide_tablet": "hidden-tablet", "hide_mobile": "hidden-mobile", "__globals__": {"background_overlay_color": "globals/colors?id=0712892"}}, "elements": [{"id": "29b04101", "elType": "widget", "settings": {"title": "ALL SERVICES", "nav_menus": [{"_id": "4b4c20a", "nav_menu": "services-menu"}]}, "elements": [], "widgetType": "sidebar-nav"}, {"id": "6f1ddb3", "elType": "widget", "settings": {"skin": "cover", "layout": "above", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "graphic_element": "icon", "selected_icon": {"value": "icon icon-contact-form", "library": "ekiticons"}, "title": "MONDAY TO SATURDAY", "title_tag": "span", "description": "905-878-7775", "description_tag": "span", "button": "Book Appointment", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "vertical_position": "middle", "title_typography_typography": "custom", "title_typography_font_family": "Plus Jakarta Sans", "title_typography_font_size": {"unit": "px", "size": 26, "sizes": []}, "title_typography_font_weight": "600", "title_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "description_typography_typography": "custom", "description_typography_font_family": "Plus Jakarta Sans", "description_typography_font_weight": "600", "description_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "button_text_color": "#FFFFFF", "button_background_color": "#8695D8", "_margin": {"unit": "px", "top": "30", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "__globals__": {"title_typography_typography": "globals/typography?id=secondary", "description_typography_typography": "globals/typography?id=accent", "button_background_color": "globals/colors?id=secondary", "button_text_color": "globals/colors?id=0712892", "button_border_color": ""}, "link_click": "box"}, "elements": [], "widgetType": "global", "templateID": "10400"}], "isInner": true}], "isInner": false}, {"id": "4249e5c", "elType": "container", "settings": {"padding": {"unit": "px", "top": "50", "right": "0", "bottom": "50", "left": "0", "isLinked": ""}, "ekit_all_conditions_list": [{"_id": "ca7a7c3"}], "ekit_section_parallax_multi_items": [], "ekit_cursor_text_label": "Elementskit Cursor", "flex_direction": "column", "flex_align_items": "stretch", "flex_gap": {"size": 10, "column": "10", "row": "10", "unit": "px", "isLinked": true}, "padding_tablet": {"unit": "px", "top": "70", "right": "10", "bottom": "70", "left": "10", "isLinked": false}, "__globals__": {"background_color": "globals/colors?id=8891650", "background_color_b": ""}, "background_color_b": "#FFFFFF", "background_color": "#F3E5F2", "background_color_b_stop": {"unit": "%", "size": 28, "sizes": []}}, "elements": [{"id": "782bdc1", "elType": "widget", "settings": {"title": "FAQs About Workplace Ergonomics Assessment", "header_size": "h3", "title_color": "#000000", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "500", "typography_text_transform": "capitalize", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "e2e6de9"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "aa60a26"}]}, "elements": [], "widgetType": "heading"}, {"id": "e8f1a5e", "elType": "widget", "elements": [], "widgetType": "elementskit-accordion", "settings": {"ekit_accordion_items": [{"acc_title": "Do I need to bring my chair to the clinic?", "acc_content": "<p>No. Photos or a short video of your desk from the side and from behind you are enough for most office assessments. On-site visits can be discussed for teams.</p>", "ekit_acc_is_active": "yes", "_id": "3c803c2"}, {"acc_title": "Is this only for office workers?", "acc_content": "<p>No. Anyone with a repeated work posture or lift can benefit, including trades and standing jobs.</p>", "ekit_acc_is_active": "", "_id": "a71ff42"}, {"acc_title": "Will you sell me a new chair?", "acc_content": "<p>We recommend setup changes first. If a chair or desk is clearly the problem, we will say what to look for. We are not a furniture store.</p>", "ekit_acc_is_active": "", "_id": "f5abacc"}, {"acc_title": "Can ergonomics fix pain I already have?", "acc_content": "<p>It reduces the ongoing strain. If tissues are already irritated, you still need physiotherapy. The two work together.</p>", "ekit_acc_is_active": "", "_id": "cd86db1"}, {"acc_title": "How long is the appointment?", "acc_content": "<p>Treat it as a physiotherapy visit with extra time on your work tasks and setup, not a five-minute checklist.</p>", "ekit_acc_is_active": "", "_id": "00737ae"}, {"acc_title": "Can my employer book this for the team?", "acc_content": "<p>Yes. Contact the clinic to discuss a practical session for staff.</p>", "ekit_acc_is_active": "", "_id": "28e92b2"}, {"acc_title": "Do standing desks prevent back pain?", "acc_content": "<p>They help some people if you alternate positions. Standing all day can create different problems. Variation matters more than one \u201cperfect\u201d posture.</p>", "ekit_acc_is_active": "", "_id": "5f1bd08"}, {"acc_title": "How do I book?", "acc_content": "<p>Book online or call Tonic Physio in Milton and ask for a workplace ergonomics assessment.</p>", "ekit_acc_is_active": "", "_id": "520056e"}], "ekit_accordian_faq_schema": "yes", "ekit_accordion_background_color": "#473872", "ekit_accordion_title_color_close": "#FFFFFF", "ekit_accordion_background_close_background": "classic", "ekit_accordion_background_close_color": "#473872", "__globals__": {"ekit_accordion_title_color_close": "globals/colors?id=0712892", "ekit_accordion_background_close_color": "globals/colors?id=accent", "ekit_accordion_content_background_color": "globals/colors?id=text", "ekit_accordion_content_color": "globals/colors?id=text", "ekit_accordion_content_typography_typography": "globals/typography?id=text"}, "ekit_accordion_content_border_radious": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}, "ekit_accordion_content_padding": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}}}], "isInner": false}, {"id": "60186c47", "elType": "container", "settings": {"flex_direction": "column", "content_width": "full", "min_height": {"unit": "px", "size": 280, "sizes": []}, "background_background": "classic", "background_image": {"url": "https://tonicphysio.com/wp-cont
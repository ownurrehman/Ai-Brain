", "right": "15", "bottom": "0", "left": "15", "isLinked": false}}, "elements": [{"id": "b2a709c", "elType": "widget", "settings": {"shortcode": "[wpseo_breadcrumb]"}, "elements": [], "widgetType": "global", "templateID": "11123"}, {"id": "b26ef64", "elType": "widget", "settings": {"title": "WSIB Care Programs", "header_size": "h1", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "heading"}, {"id": "fb2de65", "elType": "widget", "settings": {"editor": "<div><p><span style=\"font-size: 16px;\">Workplace injuries can disrupt daily life, affect mobility, and limit the ability to work comfortably and safely. That\u2019s where WSIB Care Programs come in, providing comprehensive rehabilitation services, including physiotherapy, to help injured workers regain strength, restore function, and return to work safely.</span></p><p>At Tonic Physio, we understand the unique demands of workplace injury recovery. Our experienced team offers WSIB physiotherapy in Milton customized to each worker\u2019s specific condition and job requirements. Through personalized treatment plans incorporating manual therapy, therapeutic exercise, and pain management strategies, we work to restore movement, reduce discomfort, and prevent long-term complications.</p><p>If you\u2019re searching for WSIB physiotherapy near me, Tonic Physio is your trusted choice for evidence-based, compassionate care that focuses on long-term recovery and well-being.</p></div><div><!-- /.service-details__text --></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "d3ac145"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "37dba0e"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5bd4a37", "elType": "widget", "settings": {"skin": "cover", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "title": "Feel Better. Move Better. Live Fully.", "title_tag": "span", "description": "Trusted care that helps you move better and feel better. Call or book online now.", "description_tag": "span", "button": "Book Appointment Now", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "button_hover_background_color": "#8695D8", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "10", "left": "0", "isLinked": false}, "__globals__": {"button_hover_background_color": ""}, "ribbon_title": "Tonic Physio", "ribbon_horizontal_position": "right", "motion_fx_motion_fx_scrolling": "yes"}, "elements": [], "widgetType": "global", "templateID": "9260"}, {"id": "c285d5e", "elType": "widget", "settings": {"editor": "<div>\n  <h2>Programs Offered at Tonic Physio</h2>\n  <p>The Musculoskeletal Program of Care (MSK POC) is designed to address workplace injuries affecting muscles, joints, ligaments, and tendons. Common conditions include sprains, strains, back pain, and repetitive strain injuries. This program combines:</p>\n\n  <ul>\n    <li>Manual therapy</li>\n    <li>Targeted exercise rehabilitation</li>\n    <li>Postural retraining</li>\n    <li>Pain management strategies</li>\n  </ul>\n  <p>Our physiotherapists create individualized recovery plans that help improve strength, flexibility, and mobility, all essential for safely returning to work.</p>\n</div>\n<div><!-- /.service-details__text --></div>\n", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "1809915"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0fea156"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "5b7f42b", "elType": "widget", "settings": {"editor": "<div>\n  <h2>Mild Traumatic Brain Injury (mTBI) Program of Care</h2>\n  <p>For workers recovering from concussions and other mild head injuries, the mTBI Program of Care offers specialized treatment customized to cognitive and physical rehabilitation. Key components include:</p>\n  <ul>\n    <li>Structured neurological assessments</li>\n    <li>Gradual, supervised return-to-work planning</li>\n    <li>Balance, coordination, and cognitive retraining</li>\n    <li>Pain and stress management techniques</li>\n  </ul>\n  <p>This program ensures workers recover safely and thoroughly before resuming their job duties.</p>\n</div>\n<div><!-- /.service-details__text --></div>\n", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "92c6f74"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "7cb9ba2"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "b114d6d", "elType": "widget", "settings": {"image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/wsib-care-programs-points.png", "id": 5360, "size": "", "alt": "WSIB care program recovery points", "source": "library"}, "image_size": "full", "align": "center", "_margin": {"unit": "px", "top": "10", "right": "0", "bottom": "20", "left": "0", "isLinked": false}}, "elements": [], "widgetType": "image"}, {"id": "039091a", "elType": "widget", "settings": {"editor": "<div><h2>What WSIB Care at Tonic Physio Includes</h2><p>These are the practical pieces we build into your plan:</p><ul><li>Customized rehabilitation programs aimed at a safe return to work.</li><li>Timely assessment and treatment to limit long-term complications.</li><li>Hands-on therapy and exercise to reduce pain and restore mobility.</li><li>Guidance on workplace modifications and gradual return-to-work plans.</li><li>Regular progress reviews shared with your care team as needed.</li><li>Support for the physical and functional effects of workplace injury.</li></ul></div>", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "647f783"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "0a4dff0"}]}, "elements": [], "widgetType": "text-editor"}, {"id": "9f8a561", "elType": "widget", "settings": {"editor": "<div>\n  <h2>Why Choose Tonic Physio for WSIB Physiotherapy in Milton?</h2>\n  <p>Tonic Physio has been a trusted provider of WSIB physiotherapy services in Milton for over 25 years. Our clinic has built a reputation for delivering high-quality, compassionate, and results-driven rehabilitation care.</p>\n  \n  <p>We maintain strong communication with WSIB case managers and healthcare providers to ensure seamless reporting, timely treatment updates, and collaborative care plans that prioritize your recovery and job readiness.</p>\n  \n  <p>If you're seeking WSIB physiotherapy near me, Tonic Physio offers the experience, resources, and patient-first approach you deserve.</p>\n</div>\n<div><!-- /.service-details__text --></div>\n", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "align": "left", "text_color": "#000000", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "aef1606"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "49a15fd"}]}, "elements": [], "widgetType": "text-editor"}], "isInner": true}, {"id": "2f8706ae", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 25}, "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "20", "isLinked": false}, "background_overlay_opacity": {"unit": "px", "size": 1, "sizes": []}, "border_border": "none", "border_radius": {"unit": "px", "top": "20", "right": "20", "bottom": "20", "left": "20", "isLinked": true}, "_flex_size": "none", "css_classes": "service-sidebar__info service-sidebar__single", "hide_tablet": "hidden-tablet", "hide_mobile": "hidden-mobile", "__globals__": {"background_overlay_color": "globals/colors?id=0712892"}}, "elements": [{"id": "29b04101", "elType": "widget", "settings": {"title": "ALL SERVICES", "nav_menus": [{"_id": "4b4c20a", "nav_menu": "services-menu"}]}, "elements": [], "widgetType": "sidebar-nav"}, {"id": "6f1ddb3", "elType": "widget", "settings": {"skin": "cover", "layout": "above", "bg_image": {"url": "https://tonicphysio.com/wp-content/uploads/2024/11/page-banner-pattren-2.png", "id": 5813, "size": "", "alt": "Tonic Physio banner", "source": "library"}, "graphic_element": "icon", "selected_icon": {"value": "icon icon-contact-form", "library": "ekiticons"}, "title": "MONDAY TO SATURDAY", "title_tag": "span", "description": "905-878-7775", "description_tag": "span", "button": "Book Appointment", "link": {"url": "https://tonicphysio.janeapp.com/", "is_external": "", "nofollow": "", "custom_attributes": ""}, "vertical_position": "middle", "title_typography_typography": "custom", "title_typography_font_family": "Plus Jakarta Sans", "title_typography_font_size": {"unit": "px", "size": 26, "sizes": []}, "title_typography_font_weight": "600", "title_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "description_typography_typography": "custom", "description_typography_font_family": "Plus Jakarta Sans", "description_typography_font_weight": "600", "description_typography_letter_spacing": {"unit": "px", "size": 1, "sizes": []}, "button_text_color": "#FFFFFF", "button_background_color": "#8695D8", "_margin": {"unit": "px", "top": "30", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "__globals__": {"title_typography_typography": "globals/typography?id=secondary", "description_typography_typography": "globals/typography?id=accent", "button_background_color": "globals/colors?id=secondary", "button_text_color": "globals/colors?id=0712892", "button_border_color": ""}, "link_click": "box"}, "elements": [], "widgetType": "global", "templateID": "10400"}], "isInner": true}], "isInner": false}, {"id": "4249e5c", "elType": "container", "settings": {"padding": {"unit": "px", "top": "50", "right": "0", "bottom": "50", "left": "0", "isLinked": ""}, "ekit_all_conditions_list": [{"_id": "ca7a7c3"}], "ekit_section_parallax_multi_items": [], "ekit_cursor_text_label": "Elementskit Cursor", "flex_direction": "column", "flex_align_items": "stretch", "flex_gap": {"size": 10, "column": "10", "row": "10", "unit": "px", "isLinked": true}, "padding_tablet": {"unit": "px", "top": "70", "right": "10", "bottom": "70", "left": "10", "isLinked": false}, "__globals__": {"background_color": "globals/colors?id=8891650", "background_color_b": ""}, "background_color_b": "#FFFFFF", "background_color": "#F3E5F2", "background_color_b_stop": {"unit": "%", "size": 28, "sizes": []}}, "elements": [{"id": "782bdc1", "elType": "widget", "settings": {"title": "FAQs About WSIB Care Programs", "header_size": "h3", "title_color": "#000000", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "500", "typography_text_transform": "capitalize", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "e2e6de9"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "aa60a26"}]}, "elements": [], "widgetType": "heading"}, {"id": "fcf0fdf", "elType": "widget", "elements": [], "widgetType": "elementskit-accordion", "settings": {"ekit_accordion_items": [{"acc_title": "What are WSIB Care Programs?", "acc_content": "<p>WSIB Care Programs are structured rehabilitation programs funded by Ontario\u2019s Workplace Safety and Insurance Board to help injured workers recover and return to work safely. They give you access to physiotherapy and other evidence-based care from WSIB-approved providers, based on your injury type.</p>", "ekit_acc_is_active": "yes", "_id": "9a17d2e"}, {"acc_title": "What types of injuries does a WSIB program cover?", "acc_content": "<p>Coverage commonly includes musculoskeletal injuries, repetitive strain injuries, fractures, sprains and strains, post-surgical rehabilitation, mild traumatic brain injuries (concussions), and related workplace conditions. Your specific coverage depends on your approved claim.</p>", "ekit_acc_is_active": "", "_id": "07123f5"}, {"acc_title": "What is the WSIB Musculoskeletal Program of Care?", "acc_content": "<p>This program provides structured physiotherapy for workers with musculoskeletal injuries, with a focus on pain reduction, restoring function, and preparing you to return to work.</p>", "ekit_acc_is_active": "", "_id": "ae46b6b"}, {"acc_title": "What is the WSIB Mild Traumatic Brain Injury Program of Care?", "acc_content": "<p>This program is for workers recovering from concussions and mild brain injuries. Care may include vestibular work, graded activity, and a supervised return to work.</p>", "ekit_acc_is_active": "", "_id": "d9c6069"}, {"acc_title": "How do I access WSIB Care Programs?", "acc_content": "<p>File a claim with the WSIB first. Once your claim is approved, you can attend a WSIB-approved clinic such as Tonic Physio in Milton for assessment and treatment.</p>", "ekit_acc_is_active": "", "_id": "6630edb"}, {"acc_title": "How long will I need WSIB physiotherapy?", "acc_content": "<p>Length of care depends on the injury, your job demands, and how you progress. Your physiotherapist and the WSIB review the plan and can adjust it as recovery continues.</p>", "ekit_acc_is_active": "", "_id": "1f02192"}, {"acc_title": "Are there costs for WSIB Care Programs?", "acc_content": "<p>Approved WSIB treatment is typically billed directly to the WSIB, so you should not pay out of pocket for covered services. Care outside the approved plan may not be covered.</p>", "ekit_acc_is_active": "", "_id": "96bcb5d"}, {"acc_title": "How do I report a workplace injury?", "acc_content": "<p>Tell your employer as soon as you can and seek medical care if needed. Employers must report lost-time injuries or injuries needing more than first aid to the WSIB within the required timeframe.</p>", "ekit_acc_is_active": "", "_id": "11d68fb"}, {"acc_title": "What benefits can the WSIB provide?", "acc_content": "<p>Depending on the claim, benefits may include health-care coverage, loss-of-earnings support, return-to-work assistance, and help with lasting impairment.</p>", "ekit_acc_is_active": "", "_id": "11ff80c"}, {"acc_title": "How can I appeal a WSIB decision?", "acc_content": "<p>If you disagree with a WSIB decision, you can file a written objection, generally within six months of the decision date. Details are on the WSIB website.</p>", "ekit_acc_is_active": "", "_id": "e421c78"}, {"acc_title": "What is a clearance certificate?", "acc_content": "<p>A clearance certificate shows a business is registered with the WSIB and up to date on premiums. Principals hiring contractors often request one to limit liability for the contractor\u2019s premiums.</p>", "ekit_acc_is_active": "", "_id": "7e6f7e2"}, {"acc_title": "What if I still need treatment after WSIB coverage ends?", "acc_content": "<p>Your provider can request an extension when more care is medically needed. Approval is decided by the WSIB.</p>", "ekit_acc_is_active": "", "_id": "e82c89b"}, {"acc_title": "Can I choose my physiotherapy clinic for WSIB treatment?", "acc_content": "<p>Yes. You can choose a WSIB-approved clinic. Tonic Physio in Milton provides WSIB physiotherapy and reports.</p>", "ekit_acc_is_active": "", "_id": "6152775"}], "ekit_accordian_faq_schema": "yes", "ekit_accordion_background_color": "#473872", "ekit_accordion_title_color_close": "#FFFFFF", "ekit_accordion_background_close_background": "classic", "ekit_accordion_background_close_color": "#473872", "__globals__": {"ekit_accordion_title_color_close": "globals/colors?id=0712892", "ekit_accordion_background_close_color": "globals/colors?id=accent", "ekit_
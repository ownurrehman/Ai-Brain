{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rankray-hq/hermes-task-action-payload",
  "title": "Hermes Task Action Payload",
  "description": "JSON body RankRay HQ sends to HERMES_GATEWAY_URL /v1/agents/run when a Task AI Action is triggered. Frontend posts to POST /api/agents/hermes/task-actions; backend builds this envelope and forwards to Hermes (or a HERMES-framework Agent).",
  "type": "object",
  "required": [
    "schemaVersion",
    "action",
    "workspaceId",
    "task",
    "company",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "action": {
      "type": "string",
      "enum": ["generate_seo_audit", "draft_content_structure"]
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "task": {
      "type": "object",
      "required": ["id", "name", "description", "status", "priority", "dueDate", "projectId", "companyId"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "dueDate": { "type": ["string", "null"], "format": "date-time" },
        "projectId": { "type": ["string", "null"], "format": "uuid" },
        "companyId": { "type": ["string", "null"], "format": "uuid" }
      },
      "additionalProperties": false
    },
    "company": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "name", "website", "industry"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "name": { "type": "string" },
            "website": { "type": ["string", "null"] },
            "industry": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "instruction": {
      "type": "string",
      "description": "Optional human-readable instruction appended when routing through AgentRunner."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schemaVersion": "1.0",
      "action": "generate_seo_audit",
      "workspaceId": "11111111-1111-1111-1111-111111111111",
      "task": {
        "id": "22222222-2222-2222-2222-222222222222",
        "name": "Q3 SEO audit for Acme",
        "description": "Full technical + content audit",
        "status": "in-progress",
        "priority": "high",
        "dueDate": "2026-07-20T00:00:00.000Z",
        "projectId": "33333333-3333-3333-3333-333333333333",
        "companyId": "44444444-4444-4444-4444-444444444444"
      },
      "company": {
        "id": "44444444-4444-4444-4444-444444444444",
        "name": "Acme Corp",
        "website": "https://acme.example",
        "industry": "SaaS"
      },
      "requestedAt": "2026-07-14T16:00:00.000Z"
    }
  ]
}

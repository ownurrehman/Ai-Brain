#!/bin/bash
# Transcribe audio file using faster-whisper (local, no API)
# Usage: whisper-transcribe <audio_file>

AUDIO="$1"
if [ -z "$AUDIO" ]; then
    echo "Usage: whisper-transcribe <audio_file>"
    exit 1
fi

PYTHON=/Users/sheikhown/.openclaw/whisper-env/bin/python

$PYTHON -c "
from faster_whisper import WhisperModel
import sys

model = WhisperModel('tiny', device='cpu', compute_type='int8')
segments, info = model.transcribe(sys.argv[1], beam_size=1)
for seg in segments:
    print(seg.text.strip())
" "$AUDIO"